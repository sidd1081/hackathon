# Copy this file to .env and adjust values as needed:
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# Most values have sensible defaults in app/core/config.py. GROQ_API_KEY is
# required for RCA generation (the LLM layer).

# ---- Application ----
APP_NAME=AI-Powered Incident RCA Assistant
API_PREFIX=/api
DEBUG=false
LOG_LEVEL=INFO

# ---- LLM: Groq (used for the LLM only, never embeddings) ----
# Get a key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
# Chat model your key can access (see https://console.groq.com/docs/models).
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.0
# Retries on transient failures (notably free-tier 429 rate limits).
GROQ_MAX_RETRIES=6

# ---- Embeddings (local, via Sentence Transformers; not Groq) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Auth (JWT) ----
# MUST be overridden in production. Use a long random string (>= 32 bytes),
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=dev-insecure-change-me-set-JWT_SECRET-in-prod
JWT_EXPIRE_MINUTES=720
