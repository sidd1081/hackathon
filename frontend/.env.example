# Base URL the frontend uses for API calls.
# Leave EMPTY to use the Vite dev proxy (recommended in development) — requests
# to /api are forwarded to VITE_API_PROXY_TARGET below.
VITE_API_BASE_URL=

# Backend the Vite dev server proxies /api to (dev only).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
