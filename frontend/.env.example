# Base URL the frontend uses for API calls.
#
# - Local dev: leave EMPTY to use the Vite dev proxy (requests to /api are
#   forwarded to VITE_API_PROXY_TARGET below).
# - Production (e.g. Vercel): set this to your backend's URL so the browser
#   calls it directly, e.g.
#     VITE_API_BASE_URL=https://<your-space>.hf.space
#   (No trailing slash. The backend must allow this site via CORS_ORIGINS.)
VITE_API_BASE_URL=

# Backend the Vite dev server proxies /api to (dev only; ignored in prod builds).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
